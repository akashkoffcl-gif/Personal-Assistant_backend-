# ==============================================================================
# PERSONAL ASSISTANT PWA - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# API Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Next.js Web App Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase PostgreSQL Configuration
# DATABASE_URL: Pooled connection string (Transaction pooler for serverless/API queries, port 6543)
# DIRECT_URL: Direct session connection string (for Prisma migrations, port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Auth & Storage API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-at-least-32-chars"

# Redis Configuration (BullMQ & Cache)
REDIS_HOST="your-redis-host.redis.io"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
REDIS_URL="redis://default:your-redis-password@your-redis-host.redis.io:6379"

# Web Push Notification Infrastructure (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@yourdomain.com"

# Security & Sessions
SESSION_SECRET="your-session-secret-random-32-bytes"
