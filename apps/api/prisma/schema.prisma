datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskCategory {
  PERSONAL_ROUTINE
  WORK
  DAY_PLAN
  EMERGENCY
  ROUTINE
  PLANNING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum SchedulingMode {
  FIXED
  FLEXIBLE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
  WEEKLY
  CUSTOM
}

enum ReminderStatus {
  SCHEDULED
  ENQUEUED
  PROCESSING
  SENT
  DELIVERED
  DISMISSED
  FAILED
  CANCELLED
}

enum ScheduleChangeReason {
  EMERGENCY_INSERTION
  MANUAL_RESCHEDULE
  CONFLICT_RESOLVED
  EMERGENCY_CANCELLED
  PLAN_OPTIMIZATION
}

enum WellnessMetricType {
  HYDRATION
  EXERCISE
  MEAL
  SLEEP
  BREAK
  MOOD
  ENERGY
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// 1. User Model
model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  fullName              String?
  timezone              String                 @default("UTC")
  createdAt             DateTime               @default(now()) @db.Timestamptz
  updatedAt             DateTime               @updatedAt @db.Timestamptz

  settings              UserSettings?
  tasks                 Task[]
  routines              Routine[]
  routineOccurrences    RoutineOccurrence[]
  schedulePlans         SchedulePlan[]
  scheduleChanges       ScheduleChange[]
  reminders             Reminder[]
  pushSubscriptions     PushSubscription[]
  taskEvents            TaskEvent[]
  wellnessMetrics       WellnessMetric[]
  wellnessCheckIns      WellnessCheckIn[]
  wellnessDailySummaries WellnessDailySummary[]
  dailySummaries        DailySummary[]
  projects              Project[]
  automationRules       AutomationRule[]
  automationRuleExecutions AutomationRuleExecution[]
  usageEvents           UsageEvent[]
  notifications         InAppNotification[]
  focusSessions         FocusSession[]
  focusPreference       FocusPreference?
  goals                 Goal[]
  goalMilestones        GoalMilestone[]
  goalProgressLogs      GoalProgressLog[]
  knowledgeFolders      KnowledgeFolder[]
  knowledgeNotes        KnowledgeNote[]
  knowledgeTags         KnowledgeTag[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  knowledgeRelations    KnowledgeRelation[]
  bookmarks             Bookmark[]
  financeAccounts       FinanceAccount[]
  financeCategories     FinanceCategory[]
  financeTransactions   FinanceTransaction[]
  financeBudgets        FinanceBudget[]
  savingsGoals          SavingsGoal[]
  recurringTransactions RecurringTransaction[]
  aiConversations       AIConversation[]
  aiMessages            AIMessage[]
  aiActions             AIAction[]
  planningProposals     PlanningProposal[]
  mobileDevices         MobileDevice[]
  mobilePushTokens      MobilePushToken[]
  mobileEvents          MobileEvent[]
  mobileCommands        MobileCommand[]

  @@map("users")
}

// 2. UserSettings Model
model UserSettings {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  workStartHour             Int      @default(9)
  workEndHour               Int      @default(18)
  quietHoursStart           Int      @default(22)
  quietHoursEnd             Int      @default(7)
  maxFollowUps              Int      @default(3)
  followUpIntervalMinutes   Int      @default(15)
  enablePush                Boolean  @default(true)
  enableGentleReminders     Boolean  @default(true)
  autoRescheduleOnEmergency Boolean  @default(true)
  defaultBufferMinutes      Int      @default(10)
  preferredWorkDays         Int[]    @default([1, 2, 3, 4, 5])
  defaultTaskDurationMinutes Int     @default(30)
  defaultReminderLeadMinutes Int     @default(15)
  weekStartDay              Int      @default(1)
  updatedAt                 DateTime @updatedAt @db.Timestamptz

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// 3. Task Model
model Task {
  id                       String         @id @default(uuid())
  userId                   String
  title                    String
  description              String?
  notes                    String?
  category                 TaskCategory
  status                   TaskStatus     @default(TODO)
  priority                 Priority       @default(MEDIUM)
  schedulingMode           SchedulingMode @default(FLEXIBLE)
  estimatedDurationMinutes Int            @default(30)
  scheduledStartTime       DateTime?      @db.Timestamptz
  scheduledEndTime         DateTime?      @db.Timestamptz
  earliestStartTime        DateTime?      @db.Timestamptz
  deadline                 DateTime?      @db.Timestamptz
  maxDelayMinutes          Int?
  canSplit                 Boolean        @default(false)
  bufferMinutes            Int            @default(5)
  completedAt              DateTime?      @db.Timestamptz
  routineId                String?
  projectId                String?
  parentTaskId             String?
  createdAt                DateTime       @default(now()) @db.Timestamptz
  updatedAt                DateTime       @updatedAt @db.Timestamptz

  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine                  Routine?       @relation(fields: [routineId], references: [id], onDelete: SetNull)
  project                  Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTask               Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks                 Task[]         @relation("TaskSubtasks")
  reminders                Reminder[]
  taskEvents               TaskEvent[]
  scheduleChanges          ScheduleChange[]
  focusSessions            FocusSession[]

  @@index([userId, category])
  @@index([userId, status])
  @@index([userId, scheduledStartTime])
  @@index([userId, projectId])
  @@index([parentTaskId])
  @@map("tasks")
}

// 4. Project Model
model Project {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  color       String    @default("#142B4A")
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  targetDate  DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  focusSessions FocusSession[]

  @@index([userId, status])
  @@map("projects")
}

// 5. AutomationRule Model
model AutomationRule {
  id              String                    @id @default(uuid())
  userId          String
  name            String
  ruleType        String                    // OVERDUE_ALERT, UPCOMING_REMINDER, BREAK_SUGGESTION, REPEATED_POSTPONEMENT_ALERT, CONFLICT_AUTO_SUGGEST
  condition       Json                      @default("{}")
  action          Json                      @default("{}")
  cooldownMinutes Int                       @default(60)
  lastExecutedAt  DateTime?                 @db.Timestamptz
  isEnabled       Boolean                   @default(true)
  createdAt       DateTime                  @default(now()) @db.Timestamptz
  updatedAt       DateTime                  @updatedAt @db.Timestamptz

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions      AutomationRuleExecution[]

  @@index([userId, isEnabled])
  @@map("automation_rules")
}

// 6. AutomationRuleExecution Model
model AutomationRuleExecution {
  id          String         @id @default(uuid())
  ruleId      String
  userId      String
  triggeredBy String         // Trigger event name or scheduled evaluation
  actionTaken String
  status      String         // SUCCESS, SKIPPED_COOLDOWN, FAILED
  details     Json?
  executedAt  DateTime       @default(now()) @db.Timestamptz

  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, executedAt])
  @@index([ruleId])
  @@map("automation_rule_executions")
}

// 7. Routine Model
model Routine {
  id               String              @id @default(uuid())
  userId           String
  title            String
  description      String?
  frequency        RecurrenceFrequency @default(DAILY)
  customDays       Int[]               @default([])
  targetTime       String?             // "HH:MM"
  timeWindowStart  String?             // "HH:MM"
  timeWindowEnd    String?             // "HH:MM"
  durationMinutes  Int                 @default(15)
  targetQuantity   Float?
  unit             String?
  isActive         Boolean             @default(true)
  isPaused         Boolean             @default(false)
  startDate        DateTime?           @db.Timestamptz
  endDate          DateTime?           @db.Timestamptz
  streakCount      Int                 @default(0)
  createdAt        DateTime            @default(now()) @db.Timestamptz
  updatedAt        DateTime            @updatedAt @db.Timestamptz

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks            Task[]
  occurrences      RoutineOccurrence[]

  @@index([userId, isActive])
  @@map("routines")
}

// 5. RoutineOccurrence Model
model RoutineOccurrence {
  id             String     @id @default(uuid())
  routineId      String
  userId         String
  date           String     // "YYYY-MM-DD"
  status         TaskStatus @default(TODO)
  actualQuantity Float?
  completedAt    DateTime?  @db.Timestamptz
  notes          String?
  createdAt      DateTime   @default(now()) @db.Timestamptz
  updatedAt      DateTime   @updatedAt @db.Timestamptz

  routine        Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
  @@index([userId, date])
  @@map("routine_occurrences")
}

// 6. SchedulePlan Model
model SchedulePlan {
  id              String           @id @default(uuid())
  userId          String
  date            String           // "YYYY-MM-DD"
  version         Int              @default(1)
  isLocked        Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleChanges ScheduleChange[]

  @@unique([userId, date, version])
  @@index([userId, date])
  @@map("schedule_plans")
}

// 7. ScheduleChange Model
model ScheduleChange {
  id                String               @id @default(uuid())
  userId            String
  planId            String
  taskId            String
  reason            ScheduleChangeReason
  originalStartTime DateTime?            @db.Timestamptz
  originalEndTime   DateTime?            @db.Timestamptz
  revisedStartTime  DateTime?            @db.Timestamptz
  revisedEndTime    DateTime?            @db.Timestamptz
  createdAt         DateTime             @default(now()) @db.Timestamptz

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SchedulePlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  task              Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, planId])
  @@index([taskId])
  @@map("schedule_changes")
}

// 8. Reminder Model
model Reminder {
  id             String            @id @default(uuid())
  userId         String
  taskId         String
  triggerTime    DateTime          @db.Timestamptz
  status         ReminderStatus    @default(SCHEDULED)
  attemptCount   Int               @default(0)
  lastAttemptAt  DateTime?         @db.Timestamptz
  metadata       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempts       ReminderAttempt[]

  @@index([userId, status])
  @@index([triggerTime, status])
  @@map("reminders")
}

// 9. ReminderAttempt Model
model ReminderAttempt {
  id           String    @id @default(uuid())
  reminderId   String
  attemptNumber Int
  status       String    // SUCCESS, FAILED, RETRY
  responseCode Int?
  errorMessage String?
  attemptedAt  DateTime  @default(now()) @db.Timestamptz

  reminder     Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@map("reminder_attempts")
}

// 10. PushSubscription Model
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  deviceType String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_subscriptions")
}

// 11. TaskEvent Model
model TaskEvent {
  id             String      @id @default(uuid())
  taskId         String
  userId         String
  eventType      String      // CREATED, STATUS_CHANGED, SNOOZED, RESCHEDULED, SPLIT, CANCELLED
  previousStatus TaskStatus?
  newStatus      TaskStatus?
  metadata       Json?
  createdAt      DateTime    @default(now()) @db.Timestamptz

  task           Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, createdAt])
  @@map("task_events")
}

// 12. WellnessMetric Model
model WellnessMetric {
  id         String             @id @default(uuid())
  userId     String
  type       WellnessMetricType
  value      Float
  unit       String
  notes      String?
  recordedAt DateTime           @default(now()) @db.Timestamptz
  createdAt  DateTime           @default(now()) @db.Timestamptz

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("wellness_metrics")
}

// 13. WellnessCheckIn Model
model WellnessCheckIn {
  id           String   @id @default(uuid())
  userId       String
  energyScore  Int?     // 1 to 5
  moodScore    Int?     // 1 to 5
  fatigueScore Int?     // 1 to 5
  stressScore  Int?     // 1 to 5
  notes        String?
  checkInDate  String   // "YYYY-MM-DD"
  createdAt    DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
  @@map("wellness_check_ins")
}

// 14. WellnessDailySummary Model
model WellnessDailySummary {
  id                      String   @id @default(uuid())
  userId                  String
  date                    String   // "YYYY-MM-DD"
  hydrationTotalMl        Float    @default(0)
  exerciseDurationMinutes Int      @default(0)
  sleepHours              Float    @default(0)
  mealsLogged             Int      @default(0)
  breaksLogged            Int      @default(0)
  routineAdherencePercent Float    @default(0)
  adherenceTrendLabel     String   @default("Insufficient data")
  createdAt               DateTime @default(now()) @db.Timestamptz
  updatedAt               DateTime @updatedAt @db.Timestamptz

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("wellness_daily_summaries")
}

// 15. DailySummary Model
model DailySummary {
  id                      String   @id @default(uuid())
  userId                  String
  date                    String   // "YYYY-MM-DD"
  totalTasks              Int      @default(0)
  completedTasks          Int      @default(0)
  completionRatePercent   Float    @default(0)
  routinesTotal           Int      @default(0)
  routinesCompleted       Int      @default(0)
  routineAdherencePercent Float    @default(0)
  workTasksTotal          Int      @default(0)
  workTasksCompleted      Int      @default(0)
  overdueTasksCount       Int      @default(0)
  createdAt               DateTime @default(now()) @db.Timestamptz
  updatedAt               DateTime @updatedAt @db.Timestamptz

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_summaries")
}

// 16. OutboxEvent Model
model OutboxEvent {
  id            String            @id @default(uuid())
  aggregateType String            // "TASK", "SCHEDULE", "REMINDER", "EMERGENCY"
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0)
  lastError     String?
  createdAt     DateTime          @default(now()) @db.Timestamptz
  processedAt   DateTime?         @db.Timestamptz

  @@index([status, createdAt])
  @@map("outbox_events")
}

// 20. UsageEvent Model (Application Usage Analytics)
model UsageEvent {
  id             String    @id @default(uuid())
  userId         String
  sessionId      String?
  eventName      String    // e.g. "dashboard.viewed", "task.created", "task.completed", "routine.completed", "emergency.replanned"
  module         String    // "TASKS", "ROUTINES", "PROJECTS", "CALENDAR", "PLANNING", "WELLNESS", "ANALYTICS", "AUTOMATION", "SETTINGS", "DASHBOARD"
  feature        String    // e.g. "TASK_CREATE", "TASK_COMPLETE", "HABIT_LOG", "EMERGENCY_REPLAN", "WELLNESS_LOG", "RULE_CREATE", "VIEW_VISIT"
  action         String?   // "CREATE", "UPDATE", "DELETE", "VIEW", "EXECUTE", "TRIGGER"
  status         String    @default("SUCCESS") // "SUCCESS", "FAILED", "CANCELLED"
  occurredAt     DateTime  @default(now()) @db.Timestamptz
  idempotencyKey String?   @unique
  metadata       Json?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, module, occurredAt])
  @@index([userId, feature])
  @@index([userId, eventName])
  @@map("usage_events")
}

// 21. InAppNotification Model (Persistent Centralized Notification Center)
model InAppNotification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  category  String    @default("SYSTEM") // TASKS, ROUTINES, REMINDERS, SCHEDULE_CONFLICT, AUTOMATION, WELLNESS, SYSTEM
  severity  String    @default("INFO")   // SUCCESS, INFO, WARNING, ERROR
  actionUrl String?
  metadata  Json?
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, category])
  @@map("in_app_notifications")
}

// ==============================================================================
// 22. FOCUS STUDIO & DEEP WORK (Phase 27)
// ==============================================================================

enum FocusSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

model FocusSession {
  id                String             @id @default(uuid())
  userId            String
  taskId            String?
  projectId         String?
  startedAt         DateTime           @db.Timestamptz
  endedAt           DateTime?          @db.Timestamptz
  pausedAt          DateTime?          @db.Timestamptz
  pausedDuration    Int                @default(0) // total paused duration in seconds
  plannedDuration   Int                // planned focus duration in seconds
  actualDuration    Int                @default(0) // actual active focus duration in seconds
  status            FocusSessionStatus @default(ACTIVE)
  interruptionCount Int                @default(0)
  sessionType       String             @default("FOCUS") // "FOCUS", "SHORT_BREAK", "LONG_BREAK"
  notes             String?
  createdAt         DateTime           @default(now()) @db.Timestamptz
  updatedAt         DateTime           @updatedAt @db.Timestamptz

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model FocusPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  focusDurationMinutes Int      @default(25)
  shortBreakMinutes    Int      @default(5)
  longBreakMinutes     Int      @default(15)
  longBreakInterval    Int      @default(4)
  dailyTargetMinutes   Int      @default(120)
  soundEnabled         Boolean  @default(true)
  autoStartBreaks      Boolean  @default(false)
  autoStartFocus       Boolean  @default(false)
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("focus_preferences")
}

// ==============================================================================
// 23. GOALS & MILESTONES (Phase 28)
// ==============================================================================

enum GoalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  LIFE
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  ARCHIVED
}

model Goal {
  id              String            @id @default(uuid())
  userId          String
  parentId        String?
  title           String
  description     String?
  type            GoalType          @default(MONTHLY)
  status          GoalStatus        @default(IN_PROGRESS)
  priority        Priority          @default(MEDIUM)
  progressPercent Float             @default(0)
  startDate       DateTime?         @db.Timestamptz
  targetDate      DateTime?         @db.Timestamptz
  completedAt     DateTime?         @db.Timestamptz
  color           String            @default("#8B45F5")
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentGoal      Goal?             @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subGoals        Goal[]            @relation("GoalHierarchy")
  milestones      GoalMilestone[]
  progressLogs    GoalProgressLog[]

  @@index([userId, status])
  @@index([userId, type])
  @@map("goals")
}

model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  userId      String
  title       String
  order       Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime? @db.Timestamptz
  dueDate     DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, order])
  @@index([userId])
  @@map("goal_milestones")
}

model GoalProgressLog {
  id               String   @id @default(uuid())
  goalId           String
  userId           String
  previousProgress Float
  newProgress      Float
  notes            String?
  recordedAt       DateTime @default(now()) @db.Timestamptz

  goal             Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
  @@map("goal_progress_logs")
}

// ==============================================================================
// 24. PERSONAL KNOWLEDGE HUB (Phase 29)
// ==============================================================================

enum NoteCategory {
  NOTE
  JOURNAL
  IDEA
  LEARNING
}

model KnowledgeFolder {
  id         String            @id @default(uuid())
  userId     String
  name       String
  color      String            @default("#8B45F5")
  icon       String            @default("folder")
  parentId   String?
  createdAt  DateTime          @default(now()) @db.Timestamptz
  updatedAt  DateTime          @updatedAt @db.Timestamptz

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     KnowledgeFolder?  @relation("FolderSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders KnowledgeFolder[] @relation("FolderSubfolders")
  notes      KnowledgeNote[]

  @@index([userId])
  @@map("knowledge_folders")
}

enum DocumentIndexStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model KnowledgeNote {
  id           String               @id @default(uuid())
  userId       String
  folderId     String?
  projectId    String?
  title        String
  content      String               @db.Text
  summary      String?              @db.Text
  category     NoteCategory         @default(NOTE)
  isBookmarked Boolean              @default(false)
  isArchived   Boolean              @default(false)
  isPinned     Boolean              @default(false)
  isJournal    Boolean              @default(false)
  journalDate  String?
  deletedAt    DateTime?            @db.Timestamptz
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @updatedAt @db.Timestamptz

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       KnowledgeFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         KnowledgeTagOnNote[]
  versions     KnowledgeVersion[]

  @@index([userId, category])
  @@index([userId, isArchived])
  @@index([userId, deletedAt])
  @@map("knowledge_notes")
}

model KnowledgeVersion {
  id            String        @id @default(uuid())
  noteId        String
  title         String
  content       String        @db.Text
  versionNumber Int
  changeSummary String?
  createdAt     DateTime      @default(now()) @db.Timestamptz

  note          KnowledgeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, versionNumber])
  @@map("knowledge_versions")
}

model KnowledgeDocument {
  id            String              @id @default(uuid())
  userId        String
  fileName      String
  fileSize      Int
  mimeType      String
  storagePath   String
  extractedText String?             @db.Text
  status        DocumentIndexStatus @default(PENDING)
  chunkCount    Int                 @default(0)
  errorMessage  String?
  noteId        String?
  createdAt     DateTime            @default(now()) @db.Timestamptz
  updatedAt     DateTime            @updatedAt @db.Timestamptz

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([userId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String             @id @default(uuid())
  userId      String
  documentId  String?
  noteId      String?
  chunkIndex  Int
  content     String             @db.Text
  tokenCount  Int?
  embedding   Json?
  createdAt   DateTime           @default(now()) @db.Timestamptz

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, noteId])
  @@index([userId, documentId])
  @@map("knowledge_chunks")
}

model KnowledgeRelation {
  id           String   @id @default(uuid())
  userId       String
  sourceNoteId String
  targetType   String   // "NOTE", "TASK", "PROJECT", "GOAL"
  targetId     String
  relationType String   // "RELATED_NOTE", "MENTIONS_TASK", "LINKED_PROJECT", "SUPPORTS_GOAL"
  confidence   Float    @default(1.0)
  createdAt    DateTime @default(now()) @db.Timestamptz

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sourceNoteId])
  @@index([userId, targetId])
  @@map("knowledge_relations")
}

model KnowledgeTag {
  id        String               @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime             @default(now()) @db.Timestamptz

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     KnowledgeTagOnNote[]

  @@unique([userId, name])
  @@map("knowledge_tags")
}

model KnowledgeTagOnNote {
  noteId String
  tagId  String

  note   KnowledgeNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    KnowledgeTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("knowledge_tag_notes")
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  url         String
  title       String
  description String?
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("bookmarks")
}

// ==============================================================================
// 25. PERSONAL FINANCE MANAGEMENT (Phase 30)
// ==============================================================================

enum FinanceAccountType {
  CHECKING
  SAVINGS
  CREDIT
  INVESTMENT
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model FinanceAccount {
  id           String               @id @default(uuid())
  userId       String
  name         String
  type         FinanceAccountType   @default(CHECKING)
  currency     String               @default("INR")
  balance      Decimal              @default(0.0) @db.Decimal(14, 2)
  color        String               @default("#8B45F5")
  isDefault    Boolean              @default(false)
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @updatedAt @db.Timestamptz

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@index([userId])
  @@map("finance_accounts")
}

model FinanceCategory {
  id           String               @id @default(uuid())
  userId       String
  name         String
  type         TransactionType      @default(EXPENSE)
  icon         String               @default("tag")
  color        String               @default("#8B45F5")
  createdAt    DateTime             @default(now()) @db.Timestamptz
  updatedAt    DateTime             @updatedAt @db.Timestamptz

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@unique([userId, name, type])
  @@map("finance_categories")
}

model FinanceTransaction {
  id            String           @id @default(uuid())
  userId        String
  accountId     String
  categoryId    String?
  type          TransactionType
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("INR")
  date          String           // "YYYY-MM-DD"
  description   String
  notes         String?
  paymentMethod String           @default("OTHER") // "CARD", "CASH", "TRANSFER", "OTHER"
  createdAt     DateTime         @default(now()) @db.Timestamptz
  updatedAt     DateTime         @updatedAt @db.Timestamptz

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId])
  @@map("finance_transactions")
}

model FinanceBudget {
  id              String          @id @default(uuid())
  userId          String
  categoryId      String
  month           String          // "YYYY-MM"
  allocatedAmount Decimal         @db.Decimal(14, 2)
  createdAt       DateTime        @default(now()) @db.Timestamptz
  updatedAt       DateTime        @updatedAt @db.Timestamptz

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("finance_budgets")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0.0) @db.Decimal(14, 2)
  targetDate    DateTime? @db.Timestamptz
  status        String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  color         String    @default("#16A36A")
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("savings_goals")
}

model RecurringTransaction {
  id             String          @id @default(uuid())
  userId         String
  accountId      String
  categoryId     String?
  title          String
  amount         Decimal         @db.Decimal(14, 2)
  currency       String          @default("INR")
  type           TransactionType @default(EXPENSE)
  frequency      String          @default("MONTHLY") // "WEEKLY", "MONTHLY", "YEARLY"
  nextDate       String          // "YYYY-MM-DD"
  isSubscription Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("recurring_transactions")
}

// ==============================================================================
// 26. INTEGRATED AI PERSONAL ASSISTANT & SMART PLANNER (Phases 31 & 32)
// ==============================================================================

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  userId         String
  role           String         // "USER", "ASSISTANT", "SYSTEM"
  content        String         @db.Text
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime       @default(now()) @db.Timestamptz

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIAction {
  id             String    @id @default(uuid())
  userId         String
  actionType     String    // "DELETE_TASK", "SCHEDULE_CHANGE", "FINANCIAL_MUTATION", "BULK_UPDATE"
  description    String
  payload        Json
  status         String    @default("PROPOSED") // "PROPOSED", "CONFIRMED", "EXECUTED", "REJECTED"
  idempotencyKey String    @unique
  executedAt     DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ai_actions")
}

model PlanningProposal {
  id               String    @id @default(uuid())
  userId           String
  date             String    // "YYYY-MM-DD"
  status           String    @default("DRAFT") // "DRAFT", "APPROVED", "APPLIED", "REJECTED"
  explanation      String?   @db.Text
  originalSchedule Json
  proposedSchedule Json
  diffMetrics      Json?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  appliedAt        DateTime? @db.Timestamptz

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("planning_proposals")
}

// -------------------------------------------------------------
// PHASE 54: ANDROID MOBILE COMPANION & DEVICE INTELLIGENCE
// -------------------------------------------------------------

enum MobileDeviceStatus {
  PENDING_PAIRING
  PAIRED
  REVOKED
  BLOCKED
}

enum MobileCommandStatus {
  PENDING_CONFIRMATION
  APPROVED
  SENT_TO_DEVICE
  EXECUTED
  FAILED
  REJECTED
  TIMED_OUT
}

model MobileDevice {
  id               String             @id @default(uuid())
  userId           String
  deviceName       String
  deviceModel      String
  osVersion        String
  appVersion       String
  publicKey        String             @db.Text
  status           MobileDeviceStatus @default(PENDING_PAIRING)
  pairingChallenge String?            @db.Text
  challengeExpiry  DateTime?          @db.Timestamptz
  lastSeenAt       DateTime?          @db.Timestamptz
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         MobileDeviceSession[]
  pushTokens       MobilePushToken[]
  permissions      MobilePermission[]
  events           MobileEvent[]
  commands         MobileCommand[]

  @@index([userId, status])
  @@map("mobile_devices")
}

model MobileDeviceSession {
  id           String       @id @default(uuid())
  deviceId     String
  sessionToken String       @unique
  expiresAt    DateTime     @db.Timestamptz
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz

  device       MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, isActive])
  @@map("mobile_device_sessions")
}

model MobilePushToken {
  id         String       @id @default(uuid())
  deviceId   String
  userId     String
  fcmToken   String       @unique
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  device     MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([deviceId])
  @@map("mobile_push_tokens")
}

model MobilePermission {
  id            String       @id @default(uuid())
  deviceId      String
  permissionKey String       // "NOTIFICATION_LISTENER", "AUDIO_RECORD", "SYSTEM_ALERT_WINDOW", etc.
  isGranted     Boolean      @default(false)
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  device        MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, permissionKey])
  @@map("mobile_permissions")
}

model MobileEvent {
  id              String       @id @default(uuid())
  deviceId        String
  userId          String
  sourceApp       String       // Package name e.g. "com.whatsapp", "com.slack"
  appName         String?      // Display name e.g. "WhatsApp", "Slack"
  category        String       // "COMMUNICATION", "CALENDAR", "SYSTEM", "ALERT"
  title           String?
  summary         String?      @db.Text
  rawMetadata     Json?        // Redacted payload, never raw sensitive 2FA / financial data
  isDismissed     Boolean      @default(false)
  occurredAt      DateTime     @db.Timestamptz
  createdAt       DateTime     @default(now()) @db.Timestamptz

  device          MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
  @@map("mobile_events")
}

model MobileCommand {
  id                   String              @id @default(uuid())
  deviceId             String
  userId               String
  commandType          String              // "OPEN_APP", "OPEN_URL", "SHARE_TEXT", "CREATE_CALENDAR_EVENT", "SPEAK_PROMPT"
  payload              Json
  status               MobileCommandStatus @default(PENDING_CONFIRMATION)
  requiresConfirmation Boolean             @default(false)
  confirmationExpires  DateTime?           @db.Timestamptz
  executedAt           DateTime?           @db.Timestamptz
  failureReason        String?
  createdAt            DateTime            @default(now()) @db.Timestamptz
  updatedAt            DateTime            @updatedAt @db.Timestamptz

  device               MobileDevice        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([deviceId, status])
  @@map("mobile_commands")
}




